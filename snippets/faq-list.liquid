{% doc %}
  LINNHOLM-Anpassung: Gibt FAQ-Metaobjekte (Typ „faq“, Felder frage/antwort) als Akkordeon aus
  und ergänzt passende FAQPage-Strukturdaten (JSON-LD) für Suchmaschinen und KI-Antworten.

  @param {metaobject[]} faqs - Liste von FAQ-Metaobjekten
  @param {string} id - Eindeutige ID-Basis für die HTML-Elemente
  @param {boolean} [schema] - FAQPage-JSON-LD ausgeben (Standard: true). Pro Seite nur einmal ausgeben.

  @example
  {% render 'faq-list', faqs: product.metafields.custom.faq.value, id: block.id %}
{% enddoc %}

{%- if faqs != blank and faqs.size > 0 -%}
  <div class="faq-list">
    {%- for faq in faqs -%}
      <div class="accordion faq-list__item">
        <details id="Faq-{{ id }}-{{ forloop.index }}">
          <summary>
            <div class="summary__title">
              <h3 class="h4 accordion__title">{{ faq.frage.value | escape }}</h3>
            </div>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div class="accordion__content rte">
            <p>{{ faq.antwort.value | escape | newline_to_br }}</p>
          </div>
        </details>
      </div>
    {%- endfor -%}
  </div>

  {%- unless schema == false -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- for faq in faqs -%}
            {
              "@type": "Question",
              "name": {{ faq.frage.value | json }},
              "acceptedAnswer": {
                "@type": "Answer",
                "text": {{ faq.antwort.value | json }}
              }
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endunless -%}
{%- endif -%}

{% stylesheet %}
  .faq-list__item .accordion__content p {
    margin: 0;
  }

  .faq-list__item summary .summary__title {
    padding-right: 1rem;
  }
{% endstylesheet %}
