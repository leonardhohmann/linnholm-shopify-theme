{%- comment -%}
  LINNHOLM-Anpassung: FAQ-Seite. Liest alle Metaobjekte vom Typ „faq“, gruppiert sie nach Thema
  und gibt einmal FAQPage-Strukturdaten für die ganze Seite aus.
{%- endcomment -%}

{%- liquid
  assign all_faqs = shop.metaobjects.faq.values
  assign topics = section.settings.topics | split: ','
-%}

<div class="page-width page-width--narrow main-faq color-{{ section.settings.color_scheme }} gradient">
  <h1 class="main-page-title page-title h0">{{ page.title | escape }}</h1>

  {%- if page.content != blank -%}
    <div class="rte main-faq__intro">{{ page.content }}</div>
  {%- endif -%}

  {%- for topic in topics -%}
    {%- assign topic_name = topic | strip -%}
    {%- capture topic_items -%}
      {%- for faq in all_faqs -%}
        {%- if faq.thema.value == topic_name -%}
          <div class="accordion">
            <details id="Faq-{{ section.id }}-{{ faq.system.handle }}">
              <summary>
                <div class="summary__title">
                  <h3 class="h4 accordion__title">{{ faq.frage.value | escape }}</h3>
                </div>
                {{- 'icon-caret.svg' | inline_asset_content -}}
              </summary>
              <div class="accordion__content rte">
                <p>{{ faq.antwort.value | escape | newline_to_br }}</p>
              </div>
            </details>
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if topic_items != blank -%}
      <section class="main-faq__topic">
        <h2 class="h2">{{ topic_name }}</h2>
        {{ topic_items }}
      </section>
    {%- endif -%}
  {%- endfor -%}
</div>

{%- if all_faqs.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for faq in all_faqs -%}
          {
            "@type": "Question",
            "name": {{ faq.frage.value | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ faq.antwort.value | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .main-faq {
    padding-top: 3.6rem;
    padding-bottom: 5rem;
  }

  .main-faq__intro {
    margin-bottom: 3rem;
  }

  .main-faq__topic {
    margin-top: 3.5rem;
  }

  .main-faq__topic .accordion__content p {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ-Seite",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "topics",
      "label": "Themen (Reihenfolge, kommagetrennt)",
      "info": "Muss mit dem Feld „Thema“ der FAQ-Metaobjekte übereinstimmen.",
      "default": "Versand,Pflege,Produkte,Über den Shop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
